{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChuKhaLi/tingqr/conformance/vectors.schema.json",
  "title": "tingqr conformance vector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "scheme",
    "kind",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "scheme": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "kind": {
      "enum": [
        "valid",
        "invalid",
        "lenient",
        "encode-invalid",
        "matrix",
        "link",
        "lookup",
        "svg",
        "expiry",
        "text"
      ]
    },
    "payload": {
      "type": "string"
    },
    "input": {
      "type": "object"
    },
    "roundTrip": {
      "type": "boolean"
    },
    "expected": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "minLength": 10
    },
    "derived": {
      "type": "boolean"
    },
    "derivedFrom": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "note": {
      "type": "string"
    },
    "errorTag": {
      "type": "string",
      "pattern": "^[0-9]{2}(\\.[0-9]{2})*$"
    },
    "render": {
      "enum": [
        "svg"
      ]
    },
    "textDependent": {
      "type": "boolean"
    },
    "warningTags": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[0-9]{2}(.[0-9]{2})*$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "errorFields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag",
          "value"
        ],
        "properties": {
          "tag": {
            "type": "string",
            "pattern": "^[0-9]{2}$"
          },
          "value": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "encode-invalid"
          }
        }
      },
      "then": {
        "required": [
          "input",
          "error"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "payload"
              ]
            },
            {
              "required": [
                "expected"
              ]
            }
          ]
        }
      },
      "else": {
        "if": {
          "properties": {
            "kind": {
              "enum": [
                "matrix",
                "link",
                "lookup",
                "svg",
                "text"
              ]
            }
          }
        },
        "then": {},
        "else": {
          "required": [
            "payload"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "valid"
          }
        }
      },
      "then": {
        "required": [
          "expected"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "lenient"
          }
        }
      },
      "then": {
        "required": [
          "expected",
          "error",
          "warnings"
        ],
        "not": {
          "required": [
            "input"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "invalid"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "expected"
              ]
            },
            {
              "required": [
                "input"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "derivedFrom": {
            "type": "string"
          }
        },
        "required": [
          "derivedFrom"
        ]
      },
      "then": {
        "required": [
          "derived"
        ],
        "properties": {
          "derived": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "matrix"
          }
        }
      },
      "then": {
        "required": [
          "input",
          "expected"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "payload"
              ]
            },
            {
              "required": [
                "error"
              ]
            }
          ]
        },
        "properties": {
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "size",
              "version",
              "ecc",
              "mask",
              "rows"
            ],
            "properties": {
              "size": {
                "type": "integer",
                "minimum": 21,
                "maximum": 177
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 40
              },
              "ecc": {
                "enum": [
                  "L",
                  "M",
                  "Q",
                  "H"
                ]
              },
              "mask": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[01]+$"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "link"
          }
        }
      },
      "then": {
        "required": [
          "input",
          "expected"
        ],
        "properties": {
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "link"
            ],
            "properties": {
              "link": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "payload"
              ]
            },
            {
              "required": [
                "error"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "lookup"
          }
        }
      },
      "then": {
        "required": [
          "input",
          "expected"
        ],
        "properties": {
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result"
            ],
            "properties": {
              "result": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "payload"
              ]
            },
            {
              "required": [
                "error"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "svg"
          }
        }
      },
      "then": {
        "required": [
          "input",
          "expected"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "payload"
              ]
            },
            {
              "required": [
                "error"
              ]
            },
            {
              "required": [
                "render"
              ]
            }
          ]
        },
        "properties": {
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "svg"
            ],
            "properties": {
              "svg": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "render"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "encode-invalid"
          },
          "scheme": {
            "const": "render"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "textDependent"
        ]
      },
      "then": {
        "properties": {
          "render": {
            "const": "svg"
          }
        },
        "required": [
          "render"
        ]
      }
    },
    {
      "if": {
        "required": [
          "warnings"
        ],
        "properties": {
          "warnings": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "warningTags"
        ]
      }
    },
    {
      "if": {
        "required": [
          "warningTags"
        ]
      },
      "then": {
        "required": [
          "warnings"
        ]
      }
    },
    {
      "if": {
        "required": [
          "errorFields"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "invalid"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "const": "UNKNOWN_SCHEME"
          }
        }
      },
      "then": {
        "required": [
          "errorFields"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "expiry"
          }
        }
      },
      "then": {
        "required": [
          "payload",
          "input",
          "expected"
        ],
        "not": {
          "required": [
            "error"
          ]
        },
        "properties": {
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nowMs"
            ],
            "properties": {
              "nowMs": {
                "type": "integer"
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result"
            ],
            "properties": {
              "result": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "text"
          }
        }
      },
      "then": {
        "required": [
          "input",
          "expected"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "payload"
              ]
            },
            {
              "required": [
                "error"
              ]
            }
          ]
        },
        "properties": {
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result"
            ],
            "properties": {
              "result": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
