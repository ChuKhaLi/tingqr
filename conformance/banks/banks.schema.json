{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChuKhaLi/tingqr/conformance/banks/banks.schema.json",
  "title": "tingqr bank list (from api.vietqr.io/v2/banks, with overrides.json applied)",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "fetchedAt", "banks"],
  "properties": {
    "source": { "type": "string", "pattern": "^https://" },
    "fetchedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "banks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bin", "code", "shortName", "name", "swift", "logoUrl"],
        "properties": {
          "bin": { "type": "string", "pattern": "^\\d{6}$" },
          "code": { "type": "string", "minLength": 1 },
          "shortName": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "swift": { "type": ["string", "null"] },
          "logoUrl": { "type": "string", "pattern": "^https://" }
        }
      }
    }
  }
}
