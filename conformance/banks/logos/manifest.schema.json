{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChuKhaLi/tingqr/conformance/banks/logos/manifest.schema.json",
  "title": "Bank logos and app icons as downloaded (written by update.mjs --fetch-logos)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "files"
  ],
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "kind",
          "key",
          "sourceUrl",
          "pageUrl",
          "license",
          "fetched",
          "sha256",
          "bytes"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^(logo/\\d{6}\\.(svg|webp)|icon/[a-z0-9-]+\\.webp)$"
          },
          "kind": {
            "enum": [
              "logo",
              "icon"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "pageUrl": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://commons\\.wikimedia\\.org/wiki/"
          },
          "license": {
            "enum": [
              "PD-textlogo",
              "PD-simple",
              "trademark-no-license"
            ]
          },
          "fetched": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the file as downloaded, when the stored file was processed"
          },
          "processed": {
            "type": "string",
            "minLength": 1,
            "description": "how the stored file was derived from the download"
          }
        },
        "dependentRequired": {
          "processed": [
            "sourceSha256"
          ],
          "sourceSha256": [
            "processed"
          ]
        }
      }
    }
  }
}
