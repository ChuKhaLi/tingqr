{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChuKhaLi/tingqr/conformance/banks/bank-apps.schema.json",
  "title": "tingqr bank apps that can be opened by URL scheme (curated by hand; update.mjs never writes it)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apps"
  ],
  "properties": {
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/app"
      }
    },
    "ignoredVietqrApps": {
      "type": "object",
      "description": "vietqr.io app ids left out on purpose, with the reason",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "scheme": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9.+-]*$"
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "bin",
        "confidence",
        "sources",
        "disagreements",
        "deviceVerified",
        "vietqrAutofill"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bin": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{6}$"
        },
        "ios": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme"
          ],
          "properties": {
            "scheme": {
              "$ref": "#/$defs/scheme"
            }
          }
        },
        "android": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package",
            "scheme",
            "host"
          ],
          "properties": {
            "package": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+$"
            },
            "scheme": {
              "$ref": "#/$defs/scheme"
            },
            "host": {
              "type": "string",
              "pattern": "^[A-Za-z0-9./_-]*$"
            }
          }
        },
        "confidence": {
          "enum": [
            "multi-source",
            "single-source"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "ref",
              "url",
              "independent",
              "checked"
            ],
            "properties": {
              "name": {
                "enum": [
                  "vietqr.io",
                  "vietnam-qr-pay",
                  "qrviet",
                  "noel-tree"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "independent": {
                "type": "boolean"
              },
              "checked": {
                "$ref": "#/$defs/date"
              }
            }
          }
        },
        "disagreements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deviceVerified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "by",
              "os",
              "date"
            ],
            "properties": {
              "by": {
                "type": "string",
                "minLength": 1
              },
              "os": {
                "enum": [
                  "Android",
                  "iOS"
                ]
              },
              "date": {
                "$ref": "#/$defs/date"
              },
              "via": {
                "type": "string"
              }
            }
          }
        },
        "vietqrAutofill": {
          "type": "boolean"
        },
        "vietqrDiffers": {
          "type": "array",
          "description": "kinds where this app differs from vietqr.io on purpose (explained in disagreements)",
          "items": {
            "enum": [
              "scheme",
              "package",
              "host"
            ]
          }
        }
      }
    }
  }
}
