{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./conformance/private/**)",
      "Grep(./conformance/private/**)",
      "Glob(./conformance/private/**)",
      "Bash(*conformance/private*)",
      "Bash(*conformance\\private*)"
    ],
    "ask": [
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(*publish*)",
      "Bash(pnpm*exec*)",
      "Bash(pnpm*dlx*)",
      "Bash(dotnet nuget push*)",
      "Bash(git push*)",
      "Bash(node conformance/tools/*)",
      "Bash(npx *)"
    ],
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm -C ts install)",
      "Bash(pnpm -C ts install --frozen-lockfile)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm -C ts test*)",
      "Bash(pnpm -C ts build*)",
      "Bash(pnpm -C ts typecheck*)",
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(dotnet restore*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh pr list*)",
      "Bash(gh issue list*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list)"
    ]
  }
}
