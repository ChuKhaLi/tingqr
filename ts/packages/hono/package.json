{
  "name": "@tingqr/hono",
  "version": "0.0.0",
  "description": "Hono helpers that serve payment QR codes as SVG from your own routes (no open query-string endpoint). Runs on Workers, Node, Bun and Deno.",
  "license": "MIT",
  "author": "Chung Nguyen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChuKhaLi/tingqr.git",
    "directory": "ts/packages/hono"
  },
  "homepage": "https://github.com/ChuKhaLi/tingqr/tree/main/ts/packages/hono#readme",
  "bugs": {
    "url": "https://github.com/ChuKhaLi/tingqr/issues"
  },
  "keywords": [
    "hono",
    "qr",
    "vietqr",
    "payment",
    "svg",
    "cloudflare-workers"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@tingqr/core": "workspace:*",
    "@tingqr/render": "workspace:*"
  },
  "peerDependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "hono": "^4.13.19"
  },
  "publishConfig": {
    "access": "public"
  }
}
