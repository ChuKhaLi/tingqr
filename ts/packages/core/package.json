{
  "name": "@tingqr/core",
  "version": "0.1.0",
  "description": "Encode, decode and detect payment QR codes (VietQR first). Zero dependencies.",
  "license": "MIT",
  "author": "Chung Nguyen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChuKhaLi/tingqr.git",
    "directory": "ts/packages/core"
  },
  "homepage": "https://github.com/ChuKhaLi/tingqr/tree/main/ts/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ChuKhaLi/tingqr/issues"
  },
  "keywords": [
    "vietqr",
    "napas",
    "emvco",
    "qr",
    "payment",
    "promptpay",
    "khqr",
    "vnpay",
    "bakong",
    "vietnam",
    "thailand",
    "cambodia",
    "bank"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vietqr": {
      "import": {
        "types": "./dist/vietqr.d.ts",
        "default": "./dist/vietqr.js"
      },
      "require": {
        "types": "./dist/vietqr.d.cts",
        "default": "./dist/vietqr.cjs"
      }
    },
    "./vnpay": {
      "import": {
        "types": "./dist/vnpay.d.ts",
        "default": "./dist/vnpay.js"
      },
      "require": {
        "types": "./dist/vnpay.d.cts",
        "default": "./dist/vnpay.cjs"
      }
    },
    "./promptpay": {
      "import": {
        "types": "./dist/promptpay.d.ts",
        "default": "./dist/promptpay.js"
      },
      "require": {
        "types": "./dist/promptpay.d.cts",
        "default": "./dist/promptpay.cjs"
      }
    },
    "./khqr": {
      "import": {
        "types": "./dist/khqr.d.ts",
        "default": "./dist/khqr.js"
      },
      "require": {
        "types": "./dist/khqr.d.cts",
        "default": "./dist/khqr.cjs"
      }
    },
    "./banks": {
      "import": {
        "types": "./dist/banks.d.ts",
        "default": "./dist/banks.js"
      },
      "require": {
        "types": "./dist/banks.d.cts",
        "default": "./dist/banks.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "ajv": "^8.20.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
