{
  "name": "@tingqr/core",
  "version": "0.0.0",
  "description": "Encode, decode and detect payment QR codes (VietQR first). Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./vietqr": {
      "import": { "types": "./dist/vietqr.d.ts", "default": "./dist/vietqr.js" },
      "require": { "types": "./dist/vietqr.d.cts", "default": "./dist/vietqr.cjs" }
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {}
}
