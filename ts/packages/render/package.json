{
  "name": "@tingqr/render",
  "version": "0.0.0",
  "description": "Render payment QR payloads as a module matrix or SVG, with an optional centre logo. QR encoder ported from Project Nayuki (MIT).",
  "license": "MIT",
  "author": "Chung Nguyen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChuKhaLi/tingqr.git",
    "directory": "ts/packages/render"
  },
  "homepage": "https://github.com/ChuKhaLi/tingqr/tree/main/ts/packages/render#readme",
  "bugs": {
    "url": "https://github.com/ChuKhaLi/tingqr/issues"
  },
  "keywords": [
    "qr",
    "qr-code",
    "svg",
    "png",
    "canvas",
    "vietqr",
    "payment"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./canvas": {
      "import": {
        "types": "./dist/canvas.d.ts",
        "default": "./dist/canvas.js"
      }
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node scripts/esm-only-canvas.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "scan-sheet": "pnpm build && node scripts/scan-sheet.mjs",
    "mutate": "stryker run"
  },
  "dependencies": {
    "@tingqr/core": "workspace:*"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "esbuild": "0.27.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
